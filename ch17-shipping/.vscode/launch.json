{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "gtklab",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/build-debug/gtklab",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "build-debug"
    },
    {
      "name": "gtklab (scratch config)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/build-debug/gtklab",
      "cwd": "${workspaceFolder}",
      "env": {
        "XDG_CONFIG_HOME": "${workspaceFolder}/.debug/config",
        "XDG_DATA_HOME": "${workspaceFolder}/.debug/data",
        "G_MESSAGES_DEBUG": "gtklab"
      },
      "preLaunchTask": "build-debug"
    },
    {
      "name": "gtklab + GTK Inspector",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/build-debug/gtklab",
      "cwd": "${workspaceFolder}",
      "env": {
        "GTK_DEBUG": "interactive"
      },
      "preLaunchTask": "build-debug"
    },
    {
      "name": "gtklab: stop on GTK criticals",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/build-debug/gtklab",
      "cwd": "${workspaceFolder}",
      "env": {
        "G_DEBUG": "fatal-criticals"
      },
      "preLaunchTask": "build-debug"
    },
    {
      "name": "gtklab (gdb)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build-debug/gtklab",
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "environment": [
        {
          "name": "G_DEBUG",
          "value": "fatal-criticals"
        }
      ],
      "setupCommands": [
        {
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "build-debug"
    },
    {
      "name": "unit tests",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/build-debug/gtklab-tests",
      "args": [
        "-tc=*argv*"
      ],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "build-debug"
    },
    {
      "name": "gtklab (ASan)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/build-asan/gtklab",
      "cwd": "${workspaceFolder}",
      "env": {
        "ASAN_OPTIONS": "detect_leaks=0",
        "G_DEBUG": "fatal-criticals"
      },
      "preLaunchTask": "build-asan"
    }
  ]
}