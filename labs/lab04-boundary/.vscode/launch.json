{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "lab",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/build-debug/lab",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "build-debug"
    },
    {
      "name": "unit tests (no GTK)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/build-debug/lab-tests",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "build-debug"
    },
    {
      "name": "lab: stop on GTK criticals",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/build-debug/lab",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "build-debug",
      "env": {
        "G_DEBUG": "fatal-criticals"
      }
    },
    {
      "name": "lab + GTK Inspector",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/build-debug/lab",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "build-debug",
      "env": {
        "GTK_DEBUG": "interactive"
      }
    },
    {
      "name": "lab (gdb)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build-debug/lab",
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "environment": [
        {
          "name": "G_DEBUG",
          "value": "fatal-criticals"
        }
      ],
      "setupCommands": [
        {
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "build-debug"
    },
    {
      "name": "lab (ASan)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/build-asan/lab",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "build-asan",
      "env": {
        "ASAN_OPTIONS": "detect_leaks=0",
        "G_DEBUG": "fatal-criticals"
      }
    }
  ]
}