digraph G { fontname="IBM Plex Sans"; fontsize=12; bgcolor="transparent"; pad=0.15; node [fontname="IBM Plex Sans", fontsize=12, shape=box, style="rounded,filled", fillcolor="#EEF2F7", color="#5B6B82", penwidth=1.2, margin="0.18,0.08"]; edge [fontname="IBM Plex Sans", fontsize=10.5, color="#5B6B82", fontcolor="#334155", arrowsize=0.7]; rankdir=LR; nodesep=0.3; ranksep=0.45;
 l2 [label="second launch", fillcolor="#DCE7F5"];
 uq [label="default flags:\nregister the id on D-Bus"];
 found [label="id already taken:\nask the first process\nto activate", fillcolor="#FFFFFF"];
 exit2 [label="second process exits\n(first opens a window)", fillcolor="#FFFFFF"];
 nu [label="G_APPLICATION_NON_UNIQUE:\nno D-Bus check"];
 own [label="startup, activate\nin its own process", fillcolor="#FFFFFF"];
 l2->uq->found->exit2; l2->nu->own;
}
