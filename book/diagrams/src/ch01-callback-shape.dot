digraph G { fontname="IBM Plex Sans"; fontsize=12; bgcolor="transparent"; pad=0.15; node [fontname="IBM Plex Sans", fontsize=12, shape=box, style="rounded,filled", fillcolor="#EEF2F7", color="#5B6B82", penwidth=1.2, margin="0.18,0.08"]; edge [fontname="IBM Plex Sans", fontsize=10.5, color="#5B6B82", fontcolor="#334155", arrowsize=0.7]; rankdir=TB; nodesep=0.3; ranksep=0.28;
 main [label="main()"];
 run [label="g_application_run"];
 loop [label="main loop: dispatch a source\n(input event, timeout, I/O, redraw)", fillcolor="#FFF6DD", color="#B08A2E"];
 emit [label="g_signal_emit: \"activate\", \"clicked\", \"close-request\" ...", fillcolor="#FFFFFF"];
 h [label="your handler", fillcolor="#DCE7F5"];
 main->run->loop->emit->h;
 h->loop [style=dashed, constraint=false, label=" return: back to\n the loop"];
}
