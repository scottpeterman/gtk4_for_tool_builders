digraph G { fontname="IBM Plex Sans"; fontsize=12; bgcolor="transparent"; pad=0.15; node [fontname="IBM Plex Sans", fontsize=12, shape=box, style="rounded,filled", fillcolor="#EEF2F7", color="#5B6B82", penwidth=1.2, margin="0.18,0.08"]; edge [fontname="IBM Plex Sans", fontsize=10.5, color="#5B6B82", fontcolor="#334155", arrowsize=0.7]; rankdir=LR; nodesep=0.3; ranksep=0.4;
 src [label="gtklab source"];
 desk [label="your desk: newer GTK\nversion macros = 4.8", fillcolor="#DCE7F5"];
 floor [label="the floor: GTK 4.8\nDebian 12 or a prefix", fillcolor="#DCE7F5"];
 c1 [label="catches: newer GTK or\nGLib function, at compile", fillcolor="#FFFFFF"];
 c2 [label="catches: behaviour, other\nlibraries, 4.8 bugs", fillcolor="#FFFFFF"];
 src -> desk [label=" every build"];
 src -> floor [label=" before a release"];
 desk -> c1; floor -> c2;
}
