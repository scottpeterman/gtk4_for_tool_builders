digraph G { fontname="IBM Plex Sans"; fontsize=12; bgcolor="transparent"; pad=0.15; node [fontname="IBM Plex Sans", fontsize=12, shape=box, style="rounded,filled", fillcolor="#EEF2F7", color="#5B6B82", penwidth=1.2, margin="0.18,0.08"]; edge [fontname="IBM Plex Sans", fontsize=10.5, color="#5B6B82", fontcolor="#334155", arrowsize=0.7]; rankdir=TB; nodesep=0.3; ranksep=0.3;
 win [label="window disposed\n(gtk_window_destroy or quit)"];
 dest [label="\"destroy\" emitted;\nsome children may already be gone", fillcolor="#FFF6DD", color="#B08A2E"];
 dtor [label="~AppWindow", fillcolor="#DCE7F5"];
 disc [label="disconnect handlers on notebook_\nremove idle, timeouts, monitor"];
 unref [label="g_object_unref(notebook_)"];
 tabs [label="pages removed, nobody listening\n~Tab, ~SessionLog, ~PtySession", fillcolor="#FFFFFF"];
 win -> dest -> dtor -> disc -> unref -> tabs;
}
