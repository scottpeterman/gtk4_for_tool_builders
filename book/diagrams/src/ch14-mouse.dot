digraph G { fontname="IBM Plex Sans"; fontsize=12; bgcolor="transparent"; pad=0.15; node [fontname="IBM Plex Sans", fontsize=12, shape=box, style="rounded,filled", fillcolor="#EEF2F7", color="#5B6B82", penwidth=1.2, margin="0.18,0.08"]; edge [fontname="IBM Plex Sans", fontsize=10.5, color="#5B6B82", fontcolor="#334155", arrowsize=0.7]; rankdir=LR; nodesep=0.3; ranksep=0.45;
 press [label="button press", fillcolor="#FFFFFF"];
 rep [label="report gesture\n(capture phase)", fillcolor="#DCE7F5"];
 claim [label="claim\nmouse report bytes\n→ \"commit\""];
 deny [label="deny"];
 sel [label="click and drag gestures\nselection, middle-click paste", fillcolor="#FFFFFF"];
 press->rep; rep->claim [label=" app asked for the mouse,\n no Shift"]; rep->deny [label=" otherwise"]; deny->sel;
}
